APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

FORECAST_HISTORICAL_WIN_RATE=0.3

# OpenAPI documentation (Scramble)
API_VERSION=1.0.0

# Scheduled forecast (Phase 6 — jalankan via `php artisan schedule:run` cron)
SCHEDULED_FORECAST_ENABLED=false
SCHEDULED_FORECAST_FREQUENCY=monthly
SCHEDULED_FORECAST_TYPE=COMBINED
SCHEDULED_FORECAST_SIMULATIONS=10000
# SCHEDULED_FORECAST_TARGET=1200000000

# Super admin (dibuat oleh database/seeders/SuperAdminSeeder.php)
SUPER_ADMIN_EMAIL=superadmin@salestrack.app
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# PRD §24: Redis digunakan untuk queue simulasi Monte Carlo asynchronous.
# Fallback aman bila server belum punya Redis: QUEUE_CONNECTION=database
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
